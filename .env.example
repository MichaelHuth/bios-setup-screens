# The bot token is read from discord-token.txt next to bot.py
# Nickname the bot gives itself in every server it is in (empty = don't change it)
BOT_NICKNAME=Gwennyfer

# Local Anthropic-compatible AI server
AI_BASE_URL=http://localhost:8080
# The API key is read from api-key.txt next to bot.py
AI_MODEL=claude-sonnet-5-5
AI_MAX_TOKENS=32000
# Rounds of tool calls per question (several calls in one step count as one round)
MAX_TOOL_ROUNDS=40
# Long answers: at most this many messages (the rest is attached as a file), seconds apart
MAX_MESSAGES=5
MESSAGE_DELAY=1.5
# SYSTEM_PROMPT=You are a friendly assistant in a Discord server.
# (Discord formatting and tool-use guidance are always added to it.)
